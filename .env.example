# Examples only: set these in your hosting service; this file is not loaded automatically.
TRACE_REQUIRE_LOGIN=1
TRACE_TWO_ACCESS=0
TRACE_DATA=/var/lib/trace-ai
TRACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.example.com
PORT=8000
SUSTIVIO_MODEL=qwen3-vl:4b
# Reachable private Ollama service; localhost cannot reach the Ollama app on your Mac from cloud hosting.
OLLAMA_HOST=http://127.0.0.1:11434
# Trust only your reverse proxy IPs; Render blueprint uses its managed proxy boundary.
FORWARDED_ALLOW_IPS=127.0.0.1
# Only the hosted fictional read-only demo uses this flag. Keep off for real data.
TRACE_PUBLIC_DEMO=0
